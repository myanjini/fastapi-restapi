# 이 파일을 .env로 복사한 뒤 값을 채웁니다. .env는 Git에 올리지 않습니다.
# 비밀 값은 아래 명령으로 만듭니다.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# 실행 환경: development 또는 production
APP_ENV=development
APP_NAME=도서 관리 API
LOG_LEVEL=INFO

# 데이터베이스(로컬 개발은 SQLite, Compose는 compose.yaml에서 PostgreSQL 주소를 넣습니다)
DATABASE_URL=sqlite:///./books.db

# [비밀] JWT 서명 키. 32자 이상, 환경마다 다르게
SECRET_KEY=
# [비밀] Compose의 PostgreSQL 비밀번호
POSTGRES_PASSWORD=

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=["http://localhost:5173"]
